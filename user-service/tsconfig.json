{
  "compilerOptions": {
    /* Base Options */
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    
    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "app/*"]
    },

    /* Output Settings */
    "outDir": "./dist",
    "sourceMap": true,
    "removeComments": true,

    /* Interop & Helpers */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* Decorators (Keep these if using NestJS/TypeORM) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["app/**/*", "*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}